# ============================================
# Smart Bin Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# For Supabase: Use the connection string from your Supabase dashboard
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?pgbouncer=true
DATABASE_URL="postgresql://postgres:your-password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# Direct connection for migrations (without pgbouncer)
DIRECT_URL="postgresql://postgres:your-password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# ============================================
# SUPABASE CONFIGURATION (for storage & auth helpers)
# ============================================
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ============================================
# JWT AUTHENTICATION
# ============================================
# IMPORTANT: Generate a strong secret key for production!
# You can generate one using: openssl rand -base64 64
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-minimum-32-characters"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ============================================
# OTP CONFIGURATION
# ============================================
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ============================================
# SMS PROVIDER (for OTP)
# ============================================
# For development: Use "mock" to simulate SMS
# For production: Use "twilio", "msg91", or "aws"
SMS_PROVIDER="mock"

# Twilio Configuration (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# MSG91 Configuration (if SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""

# AWS SNS Configuration (if SMS_PROVIDER=aws)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"

# ============================================
# FILE STORAGE
# ============================================
# For development: Use "local" or "supabase"
# For production: Use "s3" or "supabase"
STORAGE_PROVIDER="supabase"

# S3 Configuration (if STORAGE_PROVIDER=s3)
AWS_S3_BUCKET=""
AWS_S3_REGION="ap-south-1"

# Local storage path (if STORAGE_PROVIDER=local)
LOCAL_UPLOAD_PATH="./uploads"

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV="development"
PORT=3000
API_BASE_URL="http://localhost:3000"

# Frontend URLs (for CORS)
FRONTEND_URLS="http://localhost:3000,http://localhost:3001"

# ============================================
# SECURITY SETTINGS
# ============================================
# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN="*"

# ============================================
# QR CODE SETTINGS
# ============================================
QR_TOKEN_LENGTH=24
QR_BASE_URL="https://yourdomain.com/qr"

# ============================================
# PAYMENT SETTINGS
# ============================================
DEFAULT_MONTHLY_FEE=100
PAYMENT_DUE_DAY=5

# ============================================
# LOGGING
# ============================================
LOG_LEVEL="debug"
ENABLE_AUDIT_LOG=true
